# Copy to .env and adjust. Every variable is optional; the values below are the defaults
# for running the API directly on the host. docker-compose.yml sets its own values.

# Storage
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/reqtrace.db
# MODELS_CACHE_DIR=./data/models

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=reqtrace_chunks

# Embeddings (CPU). E5 models need the query/passage prefixes; set both to "" for other models.
DENSE_MODEL=intfloat/multilingual-e5-large
DENSE_QUERY_PREFIX="query: "
DENSE_PASSAGE_PREFIX="passage: "
SPARSE_MODEL=Qdrant/bm25
# EMBEDDING_THREADS=4

# LLM (Ollama on the host). Inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=300
LLM_THINK=false

# Retrieval and chunking
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_PER_PAGE=2
RETRIEVAL_PREFETCH_LIMIT=20
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# Noise filter at ingestion (applies to documents uploaded after a change)
# Text or table blocks with fewer words are dropped unless they hold a value with a
# unit or an instruction; 0 turns the check off.
INGEST_MIN_WORDS=1
# Short text (at most INGEST_REPEATED_MAX_CHARS characters) on at least this many pages
# is treated as a page header or footer and dropped; 0 turns the check off.
INGEST_REPEATED_MIN_PAGES=3
INGEST_REPEATED_MAX_CHARS=60

# Uploads and temporary drawers
MAX_UPLOAD_MB=50
TEMPORARY_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# Requirement extraction
QUOTE_MATCH_THRESHOLD=90
QUOTE_MIN_CHARS=15
# Share (0-1) of a paraphrase's significant terms that its quote must contain
REQUIREMENT_SUPPORT_THRESHOLD=0.75
DEDUP_THRESHOLD=92

# JSON list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=["http://localhost:5173"]
